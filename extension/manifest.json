{
  "manifest_version": 3,
  "name": "Auto Answer AI",
  "version": "1.0",
  "description": "AI-powered auto answer for multiple choice questions",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>", "file:///*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Auto Answer AI"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>", "file:///*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
